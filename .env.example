# ==========================================================================
# Multi-Agent Coding Task System -- configuration template
# ==========================================================================
#
# Copy to `.env` and fill in. `.env` is gitignored and is the only file that
# should ever hold a credential -- never this template, and never a commit.

# ── Active provider ────────────────────────────────────────────────────────
# mock | gemini | api | ollama | opencode | rule-based
LLM_PROVIDER=ollama

# ── Ollama: local server or Ollama Cloud ───────────────────────────────────
#
# A local server (the default) needs no key and no network:
#     OLLAMA_BASE_URL=http://localhost:11434
#     OLLAMA_MODEL=qwen2.5-coder:7b     # ollama pull qwen2.5-coder:7b
#
# Ollama Cloud needs an API key from https://ollama.com/settings/keys:
#     OLLAMA_BASE_URL=https://ollama.com
#     OLLAMA_API_KEY=<your key>
#     OLLAMA_MODEL=gpt-oss:120b
#
# Model names differ between the two: the API takes the exact name that
# `GET /api/tags` returns, while the Ollama app and CLI show the same cloud
# models with a `:cloud` suffix. Asking the API for `gpt-oss:120b-cloud` is a
# 404. A model that exists but sits outside your plan fails with a 402.
#
# `python -c "import httpx;print([m['name'] for m in httpx.get('https://ollama.com/api/tags').json()['models']])"`
# lists the cloud catalogue; the ones this project runs on are the larger
# open-weight models, e.g. gpt-oss:120b, gpt-oss:20b, gemma4:31b and the
# nemotron-3 family.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=
# Output ceiling per completion. Agents emit whole files, so leave room: an
# answer cut off at this limit is reported as truncation, not as a refusal.
OLLAMA_NUM_PREDICT=8192

# ── Google Gemini (optional) ───────────────────────────────────────────────
# Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional; defaults to Google's OpenAI-compatible endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── OpenAI / OpenAI-compatible endpoint (optional) ─────────────────────────
# Works with OpenAI, Groq, OpenRouter, DeepSeek, LocalAI, vLLM.
API_KEY=
API_MODEL=gpt-4o-mini
API_BASE_URL=https://api.openai.com/v1

# ── OpenCode CLI (optional) ────────────────────────────────────────────────
# Requires the `opencode` binary on PATH.
OPENCODE_MODEL=nemotron-3.5-lightning-free

# ── Scheduling & performance ───────────────────────────────────────────────
MAX_PARALLEL_TASKS=4
MAX_TASK_RETRIES=3
TASK_TIMEOUT_SECONDS=1800
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2

# ── Storage & paths ────────────────────────────────────────────────────────
STATE_DB_PATH=./state/orchestrations.db
WORKSPACE_ROOT=./workspaces
LOG_LEVEL=INFO

# ── Sandbox ────────────────────────────────────────────────────────────────
# Agents execute code. With this off, they run directly on the host, which is
# meant for local experimentation only. See the README before turning it on:
# it requires a working Docker daemon.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_NETWORK=none

# ── API ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
LOG_JSON=false
